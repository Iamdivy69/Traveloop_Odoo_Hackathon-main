# ─── Database ────────────────────────────────────────────────
# Full PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/traveloop

# ─── Authentication ──────────────────────────────────────────
# JWT signing secret (min 32 characters for HS256)
JWT_SECRET=your-very-long-secret-key-here-32chars-minimum

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Security ────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────
# Frontend origin for CORS whitelist
CORS_ORIGIN=http://localhost:3001
