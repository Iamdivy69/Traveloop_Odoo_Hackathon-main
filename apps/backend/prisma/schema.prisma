generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String          @unique @db.VarChar(255)
  password_hash        String
  photo_url            String?
  language             String          @default("en") @db.VarChar(10)
  is_admin             Boolean         @default(false)
  saved_destinations   String[]        @default([])
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  city                 String?         @db.VarChar(100)
  country              String?         @db.VarChar(100)
  first_name           String          @db.VarChar(100)
  last_name            String          @db.VarChar(100)
  phone                String?         @db.VarChar(20)
  bio                  String?         @db.VarChar(200)
  deleted_at           DateTime?       @db.Timestamptz(6)
  is_suspended         Boolean         @default(false)
  suspended_at         DateTime?       @db.Timestamptz(6)
  suspension_reason    String?
  is_public            Boolean         @default(true)
  preferred_currency   String          @default("INR") @db.VarChar(10)
  token_version        Int             @default(0)
  username             String?         @unique @db.VarChar(30)
  community_posts      CommunityPost[]
  expense_splits       ExpenseSplit[]
  paid_expenses        Expense[]
  received_friendships Friendship[]    @relation("ReceivedFriendRequests")
  sent_friendships     Friendship[]    @relation("SentFriendRequests")
  notifications        Notification[]
  post_likes           PostLike[]
  trips                Trip[]

  @@map("users")
}

model Trip {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String          @db.Uuid
  name            String          @db.VarChar(150)
  description     String?
  start_date      DateTime?       @db.Timestamptz(6)
  end_date        DateTime?       @db.Timestamptz(6)
  cover_photo_url String?
  is_public       Boolean         @default(false)
  share_token     String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  total_budget    Decimal?        @db.Decimal(12, 2)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  community_posts CommunityPost[]
  expenses        Expense[]
  packing_items   PackingItem[]
  notes           TripNote[]
  stops           TripStop[]
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("trips")
}

model City {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String     @db.VarChar(100)
  country          String     @db.VarChar(100)
  region           String?    @db.VarChar(100)
  cost_index       Decimal    @db.Decimal(8, 2)
  popularity_score Int        @default(0)
  description      String?
  image_url        String?
  activities       Activity[]
  stops            TripStop[]

  @@unique([name, country])
  @@index([name])
  @@map("cities")
}

model TripStop {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id        String         @db.Uuid
  city_id        String?        @db.Uuid
  custom_city_name String?      @db.VarChar(100)
  arrival_date   DateTime       @db.Timestamptz(6)
  departure_date DateTime       @db.Timestamptz(6)
  order_index    Int
  activities     StopActivity[]
  notes          TripNote[]
  city           City?          @relation(fields: [city_id], references: [id])
  trip           Trip           @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id, order_index])
  @@map("trip_stops")
}

model Activity {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id         String         @db.Uuid
  name            String         @db.VarChar(150)
  type            String         @db.VarChar(50)
  cost            Decimal        @default(0) @db.Decimal(8, 2)
  duration_mins   Int?
  description     String?
  image_url       String?
  city            City           @relation(fields: [city_id], references: [id])
  stop_activities StopActivity[]

  @@unique([city_id, name])
  @@map("activities")
}

model StopActivity {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stop_id        String    @db.Uuid
  activity_id    String?   @db.Uuid
  scheduled_time String?   @db.VarChar(10)
  custom_cost    Decimal?  @db.Decimal(8, 2)
  notes          String?
  custom_title   String?   @db.VarChar(150)
  activity       Activity? @relation(fields: [activity_id], references: [id], onDelete: Restrict)
  stop           TripStop  @relation(fields: [stop_id], references: [id], onDelete: Cascade)

  @@map("stop_activities")
}

model PackingItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id    String   @db.Uuid
  name       String   @db.VarChar(150)
  category   String   @default("other") @db.VarChar(50)
  is_packed  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  trip       Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("packing_items")
}

model TripNote {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id    String    @db.Uuid
  stop_id    String?   @db.Uuid
  content    String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  stop       TripStop? @relation(fields: [stop_id], references: [id], onDelete: Cascade)
  trip       Trip      @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("trip_notes")
}

model Expense {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id    String          @db.Uuid
  title      String          @db.VarChar(150)
  amount     Decimal         @db.Decimal(12, 2)
  currency   String          @default("INR") @db.VarChar(10)
  category   ExpenseCategory
  paid_by_id String          @db.Uuid
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  splits     ExpenseSplit[]
  paid_by    User            @relation(fields: [paid_by_id], references: [id], onDelete: Cascade)
  trip       Trip            @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
  @@index([paid_by_id])
  @@map("expenses")
}

model ExpenseSplit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expense_id String   @db.Uuid
  user_id    String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  is_paid    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  expense    Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expense_id])
  @@index([user_id])
  @@map("expense_splits")
}

model Friendship {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_id String       @db.Uuid
  receiver_id  String       @db.Uuid
  status       FriendStatus
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  receiver     User         @relation("ReceivedFriendRequests", fields: [receiver_id], references: [id], onDelete: Cascade)
  requester    User         @relation("SentFriendRequests", fields: [requester_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, receiver_id])
  @@index([requester_id])
  @@index([receiver_id])
  @@map("friendships")
}

model CommunityPost {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String     @db.Uuid
  trip_id    String?    @db.Uuid
  content    String
  image_url  String?
  is_public  Boolean    @default(true)
  likes      Int        @default(0)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  trip       Trip?      @relation(fields: [trip_id], references: [id])
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_likes PostLike[]

  @@index([user_id])
  @@index([trip_id])
  @@map("community_posts")
}

model PostLike {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String        @db.Uuid
  post_id    String        @db.Uuid
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  post       CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([post_id])
  @@map("post_likes")
}

model Notification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(50)
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notifications")
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  ACCOMMODATION
  ACTIVITY
  SHOPPING
  OTHER
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
}
