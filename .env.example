# ─── BACKEND (apps/backend/.env) ─────────────────────────────
# PostgreSQL connection (local dev uses port 5432 to avoid conflicts)
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/traveloop

# JWT signing secret (minimum 32 characters)
JWT_SECRET=your-very-long-secret-key-here-minimum-32chars

# Server
PORT=3000
NODE_ENV=development
BCRYPT_SALT_ROUNDS=12

# CORS — must match frontend origin
CORS_ORIGIN=http://localhost:3001

# ─── FRONTEND (apps/frontend/.env) ───────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ─── DOCKER (infrastructure/docker/.env.docker) ──────────────
# Used by docker-compose for the backend container
# DATABASE_URL uses 'db' hostname (docker internal network)
# DATABASE_URL=postgresql://postgres:traveloop_secret@db:5432/traveloop
